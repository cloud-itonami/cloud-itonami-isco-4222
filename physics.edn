;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a reception kiosk robot performs visitor
;; check-in, badge issuance and call routing (ISCO 4222). Its physical work is
;; handing the printed badge from the printer to the visitor, and escorting
;; the visitor from the lobby to the meeting point.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-4222"
 :cases
 [{:id :badge-handoff
   :kind :manipulator
   :procedure "desktop arm takes the printed visitor badge from the printer slot and holds it out to the visitor; a faster handoff shortens check-in"
   :params {:l1-m 0.30 :l2-m 0.25 :m1-kg 1.5 :m2-kg 1.0 :payload-kg 0.05
            :from [0.15 0.35] :to [0.50 0.15] :steps 300}
   :sweep {:param :duration-s :values [0.2 0.3 0.5 1.0 2.0]}
   :quantity :peak-tau1-nm
   :limit {:max 15.0 :basis "estimate: continuous shoulder torque of a desktop arm (~1-3 kg class)"}
   :boundary {:lo 0.05 :hi 3.0}}
  {:id :visitor-escort
   :kind :transport
   :procedure "robot escorts a checked-in visitor from the lobby to the meeting point at walking pace"
   :params {:mass-kg 45.0 :payload-kg 0.0 :v-max-mps 0.8 :a-max-mps2 0.4
            :brake-decel-mps2 0.6 :drive-force-n 90.0 :crr 0.02
            :cog-height-m 0.60 :support-half-length-m 0.25}
   :sweep {:param :distance-m :values [15.0 30.0 50.0 80.0 120.0]}
   :quantity :cycle-time-s
   :limit {:max 90.0 :basis "estimate: the robot must be back at the kiosk within about 3 minutes of a round trip, so one leg gets 90 s"}
   :boundary {:lo 2.0 :hi 400.0}}]}
